# LLM — Groq default (free tier), Gemini as fallback
GROQ_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

LLM_PROVIDER=groq
LLM_FALLBACK_PROVIDER=gemini
LLM_MODEL=llama3-8b-8192
LLM_FALLBACK_MODEL=gemini-3.6-flash

# Embeddings — fastembed is free/local (no API key). Use gemini for API embeddings.
EMBEDDING_PROVIDER=fastembed
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIM=384
# If EMBEDDING_PROVIDER=gemini:
# EMBEDDING_MODEL=text-embedding-004
# EMBEDDING_DIM=768

# PDF parsing: auto (Docling for hard layouts) | docling | pymupdf4llm | pymupdf
PDF_PARSER=auto

# Retrieval (Phase 2)
HYBRID_ENABLED=true
RERANK_ENABLED=true
RERANK_MODEL=Xenova/ms-marco-MiniLM-L-6-v2
RELEVANCE_THRESHOLD=0.35
RERANK_THRESHOLD=-5.0
GROUNDEDNESS_ENABLED=true
AGENTIC_ENABLED=true
HYDE_ENABLED=false

# Stretch: lightweight entity graph + optional LangGraph wrapper
GRAPHRAG_ENABLED=true
USE_LANGGRAPH=false

# Google Sign-In only (no passwords / API keys). Leave AUTH_ENABLED=false for local anon.
AUTH_ENABLED=false
GOOGLE_CLIENT_ID=
AUTH_JWT_SECRET=generate-with-python-c-import-secrets-print-secrets.token_urlsafe-48
AUTH_TOKEN_DAYS=14

LOG_LEVEL=INFO

# Databases
# Local (no Docker): SQLite + on-disk Qdrant
DATABASE_URL=sqlite+aiosqlite:///./ragchatbot.db
QDRANT_URL=
QDRANT_PATH=./qdrant_data
QDRANT_COLLECTION=document_chunks
# Docker Compose:
# DATABASE_URL=postgresql+asyncpg://rag:rag@localhost:5432/ragchatbot
# QDRANT_URL=http://localhost:6333
REDIS_URL=redis://localhost:6379/0

# App
BACKEND_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=50

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
