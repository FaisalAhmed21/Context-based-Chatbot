# =============================================================================
# Production env — copy to .env.production and fill in real values
#   cp .env.production.example .env.production
# Never commit .env.production
# =============================================================================

# Public hostname (DNS A/AAAA must point at this server)
DOMAIN=grounded.example.com

# Strong passwords / secrets
POSTGRES_USER=rag
POSTGRES_PASSWORD=change-me-long-random
POSTGRES_DB=ragchatbot
AUTH_JWT_SECRET=change-me-another-long-random

# LLM keys (required for chat)
GROQ_API_KEY=
GEMINI_API_KEY=

LLM_PROVIDER=groq
LLM_FALLBACK_PROVIDER=gemini
LLM_MODEL=openai/gpt-oss-20b
LLM_FALLBACK_MODEL=gemini-3.6-flash

# Embeddings stay local inside the container (CPU)
EMBEDDING_PROVIDER=fastembed
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIM=384

PDF_PARSER=auto
HYBRID_ENABLED=true
RERANK_ENABLED=true
GROUNDEDNESS_ENABLED=true
AGENTIC_ENABLED=true
GRAPHRAG_ENABLED=true
USE_LANGGRAPH=false
HYDE_ENABLED=false
RELEVANCE_THRESHOLD=0.35

# Google Sign-In (recommended in production)
AUTH_ENABLED=true
GOOGLE_CLIENT_ID=your-id.apps.googleusercontent.com
AUTH_TOKEN_DAYS=14

# Also used as Next build arg for the GIS button
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-id.apps.googleusercontent.com

# Qdrant Cloud (only for Path B — Railway). Leave empty on VPS compose (uses local qdrant service).
QDRANT_URL=
QDRANT_API_KEY=
